datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  pkId                     Int                @id @default(autoincrement())
  id                       String             @unique @default(uuid()) @db.Uuid
  firstName                String             @map("first_name") @db.VarChar(128)
  lastName                 String?            @map("last_name") @db.VarChar(128)
  username                 String?            @unique @db.VarChar(128)
  phone                    String?            @unique @db.VarChar(20)
  email                    String             @unique @db.VarChar(255)
  password                 String?            @db.VarChar(255)
  accountApiKey            String?            @unique @map("account_api_key") @db.VarChar(128)
  googleId                 String?            @unique @map("google_id") @db.VarChar(128)
  affiliationCode          String?            @unique @map("affiliation_code") @db.VarChar(128)
  emailOtpSecret           String?            @map("email_otp_secret") @db.VarChar(255)
  refreshToken             String?            @unique @map("refresh_token") @db.VarChar(255)
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime?          @default(now()) @map("updated_at")
  deletedAt                DateTime?          @map("deleted_at")
  emailVerifiedAt          DateTime?          @map("email_verfied_at")
  privilegeId              Int?               @map("privilege_id")
  privilege                Privilege?         @relation(fields: [privilegeId], references: [pkId], onDelete: SetNull)
  customerServices         CustomerService[]
  transactions             Transaction[]
  devices                  Device[]
  deviceAssignments        DeviceAssignment[] @relation("AssignedDeviceUser")
  createdDeviceAssignments DeviceAssignment[] @relation("DeviceAssignmentCreator")
  Group                    Group[]
  Subscription             Subscription[]
  Template                 Template[]
  notifications            Notification[]
  codeSnippets             CodeSnippet[]
}

model CustomerService {
  pkId         Int           @id @default(autoincrement())
  id           String        @unique @default(uuid()) @db.Uuid
  username     String        @unique @db.VarChar(255)
  email        String        @unique @db.VarChar(255)
  password     String        @db.VarChar(255)
  refreshToken String?       @unique @map("refresh_token") @db.VarChar(255)
  deletedAt    DateTime?     @map("deleted_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @default(now()) @map("updated_at")
  userId       Int
  deviceId     Int?          @unique
  privilegeId  Int?          @map("privilege_id")
  user         User          @relation(fields: [userId], references: [pkId], onDelete: Cascade)
  device       Device?       @relation(fields: [deviceId], references: [pkId], onDelete: SetNull)
  privilege    Privilege?    @relation(fields: [privilegeId], references: [pkId], onDelete: SetNull)
  Order        Order[]
  OrderMessage OrderMessage?
}

model Privilege {
  pkId             Int               @id
  id               String            @unique @default(uuid()) @db.Uuid
  name             String            @db.VarChar(128)
  users            User[]
  roles            PrivilegeRole[]
  customerServices CustomerService[]
  menuPrivileges   MenuPrivilege[]
}

model PrivilegeRole {
  pkId        Int       @id @default(autoincrement())
  id          String    @unique @default(uuid()) @db.Uuid
  isVisible   Boolean
  isCreate    Boolean
  isDelete    Boolean
  isRead      Boolean
  isEdit      Boolean
  moduleId    Int       @map("module_id")
  module      Module    @relation(fields: [moduleId], references: [pkId], onDelete: Cascade)
  privilege   Privilege @relation(fields: [privilegeId], references: [pkId], onDelete: Cascade)
  privilegeId Int       @map("privilege_id")

  @@unique([moduleId, privilegeId])
}

model Menu {
  pkId           Int             @id @default(autoincrement())
  id             String          @unique @default(uuid()) @db.Uuid
  name           String          @db.VarChar(128)
  type           String          @db.VarChar(128)
  path           String          @db.VarChar(255)
  isActive       Boolean         @map("is_active")
  menuPrivileges MenuPrivilege[]
}

model MenuPrivilege {
  pkId        Int       @id @default(autoincrement())
  id          String    @unique @default(uuid()) @db.Uuid
  menu        Menu      @relation(fields: [menuId], references: [pkId])
  menuId      Int       @map("menu_id")
  privilege   Privilege @relation(fields: [privilegeId], references: [pkId], onDelete: Cascade)
  privilegeId Int       @map("privilege_id")
}

model Module {
  pkId           Int             @id @default(autoincrement())
  id             String          @unique @default(uuid()) @db.Uuid
  name           String          @db.VarChar(128)
  controller     String          @db.VarChar(255)
  privilegeRoles PrivilegeRole[]
}

model SubscriptionPlan {
  pkId                  Int            @id @default(autoincrement())
  id                    String         @unique @default(uuid()) @db.Uuid
  name                  String         @unique @db.VarChar(128)
  monthlyPrice          Decimal        @map("monthly_price") @db.Decimal(10, 2)
  yearlyPrice           Decimal        @map("yearly_price") @db.Decimal(10, 2)
  autoReplyQuota        Int?
  broadcastQuota        Int?
  contactQuota          Int?
  deviceQuota           Int?
  isIntegration         Boolean?
  isGoogleContactSync   Boolean?
  isWhatsappContactSync Boolean?
  isAvailable           Boolean        @default(true) @map("is_available")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @default(now()) @map("updated_at")
  transactions          Transaction[]
  Subscription          Subscription[]
}

model Subscription {
  pkId               Int              @id @default(autoincrement())
  startDate          DateTime
  endDate            DateTime
  autoReplyUsed      Int              @default(0)
  broadcastUsed      Int              @default(0)
  contactUsed        Int              @default(0)
  deviceUsed         Int              @default(0)
  autoReplyMax       Int              @default(0)
  broadcastMax       Int              @default(0)
  contactMax         Int              @default(0)
  deviceMax          Int              @default(0)
  subscriptionPlanId Int
  userId             Int
  user               User             @relation(fields: [userId], references: [pkId], onDelete: Cascade)
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @map("updated_at")
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [pkId], onDelete: Cascade)
}

model Transaction {
  pkId               Int              @id @default(autoincrement())
  id                 String           @unique @map("order_id") @db.VarChar(128)
  paidPrice          Decimal          @map("paid_price") @db.Decimal(10, 2)
  status             String?
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @default(now()) @map("updated_at")
  userId             Int
  subscriptionPlanId Int
  user               User             @relation(fields: [userId], references: [pkId], onDelete: Cascade)
  subscriptionPlan   SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [pkId], onDelete: Cascade)
}

model Device {
  pkId               Int                 @id @default(autoincrement())
  id                 String              @unique @default(uuid()) @db.Uuid
  name               String              @db.VarChar(128)
  phone              String?             @db.VarChar(20)
  apiKey             String              @unique @map("api_key") @db.VarChar(255)
  status             String              @default("close") @map("status") @db.VarChar(20)
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @default(now()) @map("updated_at")
  userId             Int
  user               User                @relation(fields: [userId], references: [pkId], onDelete: Cascade)
  sessions           Session[]
  autoReplies        AutoReply[]
  campaigns          Campaign[]
  contactDevices     ContactDevice[]
  DeviceLabel        DeviceLabel[]
  Broadcast          Broadcast[]
  BusinessHour       BusinessHour[]
  CustomerService    CustomerService?
  DeviceLog          DeviceLog[]
  whatsappGroups     WhatsAppGroup[]
  IncomingMessage    IncomingMessage[]
  OutgoingMessage    OutgoingMessage[]
  inboxProfileCaches InboxProfileCache[]
  messageReactions   MessageReaction[]
  conversations      Conversation[]
  assignments        DeviceAssignment[]

  // Health monitoring fields
  healthStatus      String    @default("healthy") @map("health_status") @db.VarChar(20) // healthy, warning, critical, paused, banned
  pausedAt          DateTime? @map("paused_at")
  pauseReason       String?   @map("pause_reason") @db.VarChar(255)
  resumeAt          DateTime? @map("resume_at")
  todayMessageCount Int       @default(0) @map("today_message_count")
  todayMessageDate  DateTime? @map("today_message_date") @db.Date

  // Relations
  deviceSignals DeviceSignal[]
}

model DeviceAssignment {
  pkId         Int      @id @default(autoincrement()) @map("pk_id")
  id           String   @unique @default(uuid()) @db.Uuid
  deviceId     Int      @map("device_id")
  userId       Int      @map("user_id")
  assignedById Int?     @map("assigned_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  device       Device   @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)
  user         User     @relation("AssignedDeviceUser", fields: [userId], references: [pkId], onDelete: Cascade)
  assignedBy   User?    @relation("DeviceAssignmentCreator", fields: [assignedById], references: [pkId], onDelete: SetNull)

  @@unique([deviceId, userId], map: "device_assignments_device_user_key")
  @@index([userId], map: "idx_device_assignments_user")
  @@index([assignedById], map: "idx_device_assignments_assigned_by")
  @@map("device_assignments")
}

model DeviceLog {
  pkId      Int      @id @default(autoincrement())
  id        String   @unique @default(uuid()) @db.Uuid
  status    String   @db.VarChar(20)
  deviceId  Int
  sessionId String?
  device    Device   @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")
}

/// WhatsApp signal detection for ban prevention
/// Tracks rate limits, disconnects, and other warning signs from WhatsApp
model DeviceSignal {
  pkId       Int      @id @default(autoincrement())
  id         String   @unique @default(uuid()) @db.Uuid
  deviceId   Int      @map("device_id")
  device     Device   @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)
  signalType String   @map("signal_type") @db.VarChar(50) // rate_limit, forced_logout, connection_error, delivery_failed, banned
  code       Int? // HTTP/WA status code (429, 401, etc)
  message    String?  @db.Text
  severity   String   @default("warning") @db.VarChar(20) // info, warning, critical
  confidence String   @default("medium") @db.VarChar(20) // high, medium, low - how confident we are in the classification
  action     String?  @db.VarChar(50) // auto_paused, manual_paused, resumed, none
  metadata   Json? // Additional context
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([deviceId, createdAt], map: "idx_device_signal_device_time")
  @@index([deviceId, signalType], map: "idx_device_signal_type")
  @@map("device_signals")
}

model Session {
  pkId      Int    @id @default(autoincrement())
  id        String
  sessionId String
  data      String @db.Text
  deviceId  Int
  device    Device @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)

  @@unique([sessionId, id], map: "unique_id_per_session_id_session")
  @@index([sessionId])
}

model Contact {
  pkId            Int               @id @default(autoincrement())
  id              String            @unique @default(uuid()) @db.Uuid
  firstName       String            @db.VarChar(128)
  lastName        String?           @db.VarChar(128)
  phone           String            @db.VarChar(20)
  email           String?           @db.VarChar(255)
  gender          String?           @db.VarChar(10)
  dob             DateTime?         @db.Date
  colorCode       String?           @db.VarChar(6)
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @default(now()) @map("updated_at")
  contactGroups   ContactGroup[]
  contactDevices  ContactDevice[]
  ContactLabel    ContactLabel[]
  OutgoingMessage OutgoingMessage[]
  IncomingMessage IncomingMessage[]
  conversations   Conversation[]

  @@index([phone], name: "idx_contact_phone")
}

model Label {
  pkId         Int            @id @unique @default(autoincrement())
  name         String         @db.VarChar(128)
  slug         String         @unique @db.VarChar(128)
  DeviceLabel  DeviceLabel[]
  ContactLabel ContactLabel[]

  @@index([name])
}

model DeviceLabel {
  pkId      Int      @id @unique @default(autoincrement())
  deviceId  Int
  labelId   Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  device    Device   @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [pkId], onDelete: Cascade)

  @@unique([deviceId, labelId])
}

model ContactLabel {
  id        Int      @id @unique @default(autoincrement())
  contactId Int
  labelId   Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  contact   Contact  @relation(fields: [contactId], references: [pkId], onDelete: Cascade)
  label     Label    @relation(fields: [labelId], references: [pkId], onDelete: Cascade)

  @@unique([contactId, labelId])
  @@index([labelId])
}

model ContactGroup {
  pkId      Int     @id @default(autoincrement())
  id        String  @unique @default(uuid()) @db.Uuid
  contactId Int
  groupId   Int
  contact   Contact @relation(fields: [contactId], references: [pkId], onDelete: Cascade)
  group     Group   @relation(fields: [groupId], references: [pkId], onDelete: Cascade)

  @@unique([contactId, groupId])
}

model ContactDevice {
  pkId      Int     @id @default(autoincrement())
  id        String  @unique @default(uuid()) @db.Uuid
  contactId Int
  deviceId  Int
  contact   Contact @relation(fields: [contactId], references: [pkId], onDelete: Cascade)
  device    Device  @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)

  @@unique([contactId, deviceId])
  @@index([deviceId])
}

model Group {
  pkId          Int            @id @default(autoincrement())
  id            String         @unique @default(uuid()) @db.Uuid
  name          String         @db.VarChar(128)
  type          String         @db.VarChar(128)
  userId        Int
  user          User           @relation(fields: [userId], references: [pkId], onDelete: Cascade)
  contactGroups ContactGroup[]
  campaigns     Campaign[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @default(now()) @map("updated_at")
}

model OutgoingMessage {
  pkId          Int       @id @default(autoincrement())
  id            String    @unique
  /// WhatsApp message id returned by Baileys (key.id). Used to update delivery/read status reliably.
  waMessageId   String?   @unique @map("wa_message_id")
  to            String
  message       String?
  mediaPath     String?
  fileName      String?   @map("file_name")
  schedule      DateTime
  status        String    @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")
  inboxHiddenAt DateTime? @map("inbox_hidden_at")
  sessionId     String?
  deviceId      Int?      @map("device_id")
  contactId     Int?
  broadcastId   Int? // Add reference to broadcast
  broadcastType String?   @map("broadcast_type") @db.VarChar(20) // 🔥 NEW: 'broadcast' | 'reminder' | 'feedback' | 'recurrence'
  isGroup       Boolean?  @default(false) // Track if message is for group
  /// For group messages: list of participant JIDs who have read the message (best-effort).
  readBy        Json?     @map("read_by")
  contact       Contact?  @relation(fields: [contactId], references: [pkId], onDelete: SetNull)
  device        Device?   @relation(fields: [deviceId], references: [pkId], onDelete: SetNull)

  @@unique([sessionId, to, id], map: "unique_outgoing_message_key_per_session_id")
  @@index([broadcastId], map: "idx_outgoing_message_broadcast")
  @@index([sessionId, createdAt], map: "idx_outgoing_message_session_time")
  @@index([deviceId, createdAt], map: "idx_outgoing_message_device_time")
  @@index([deviceId, inboxHiddenAt, createdAt], map: "idx_outgoing_message_inbox_retention")
  @@index([deviceId, inboxHiddenAt, to, createdAt], map: "idx_outgoing_message_inbox_conversation")
  @@index([status], map: "idx_outgoing_message_status")
}

model IncomingMessage {
  pkId          Int       @id @default(autoincrement())
  id            String    @unique
  from          String
  participant   String? // JID pengirim untuk pesan grup
  pushName      String?   @map("push_name") // Nama profil WhatsApp pengirim
  groupName     String?   @map("group_name") // Nama grup (jika pesan dari grup)
  groupPicUrl   String?   @map("group_pic_url") // URL foto profil grup
  profilePicUrl String?   @map("profile_pic_url") // URL foto profil personal chat
  message       String
  mediaPath     String?
  fileName      String?   @map("file_name")
  isRead        Boolean   @default(false) @map("is_read") // Status pesan sudah dibaca user
  receivedAt    DateTime  @map("received_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @default(now()) @map("updated_at")
  inboxHiddenAt DateTime? @map("inbox_hidden_at")
  sessionId     String?
  deviceId      Int?      @map("device_id")
  device        Device?   @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)
  contactId     Int?
  contact       Contact?  @relation(fields: [contactId], references: [pkId], onDelete: Cascade)

  @@index([deviceId], map: "idx_incoming_message_device")
  @@index([deviceId, isRead], map: "idx_incoming_message_device_read")
  @@index([deviceId, inboxHiddenAt, receivedAt], map: "idx_incoming_message_inbox_retention")
  @@index([deviceId, inboxHiddenAt, from, receivedAt], map: "idx_incoming_message_inbox_conversation")
  @@index([deviceId, from, isRead], map: "idx_incoming_message_conversation_read")
}

/// Denormalized Inbox conversation summary. Message bodies remain in
/// IncomingMessage and OutgoingMessage; this model makes conversation lists,
/// counts, unread state, and latest-message ordering inexpensive.
model Conversation {
  pkId                 BigInt    @id @default(autoincrement()) @map("pk_id")
  deviceId             Int       @map("device_id")
  jid                  String    @db.VarChar(128)
  isGroup              Boolean   @default(false) @map("is_group")
  contactId            Int?      @map("contact_id")
  pushName              String?   @map("push_name") @db.VarChar(255)
  groupName             String?   @map("group_name") @db.VarChar(255)
  lastMessageId        String?   @map("last_message_id") @db.VarChar(255)
  lastMessageDirection String?   @map("last_message_direction") @db.VarChar(10)
  lastMessageAt        DateTime? @map("last_message_at")
  lastMessagePreview   String?   @map("last_message_preview") @db.Text
  lastMediaPath        String?   @map("last_media_path")
  lastFileName         String?   @map("last_file_name")
  incomingCount        Int       @default(0) @map("incoming_count")
  outgoingCount        Int       @default(0) @map("outgoing_count")
  unreadCount          Int       @default(0) @map("unread_count")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  device               Device    @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)
  contact              Contact?  @relation(fields: [contactId], references: [pkId], onDelete: SetNull)

  @@unique([deviceId, jid], map: "conversation_device_jid_key")
  @@index([deviceId, lastMessageAt], map: "idx_conversation_device_latest")
  @@index([deviceId, unreadCount], map: "idx_conversation_device_unread")
}

model InboxRetentionSetting {
  pkId          Int       @id @default(1) @map("pk_id")
  enabled       Boolean   @default(true)
  retentionDays Int       @default(90) @map("retention_days")
  graceDays     Int       @default(7) @map("grace_days")
  lastCleanupAt DateTime? @map("last_cleanup_at")
  updatedBy     String?   @map("updated_by") @db.VarChar(255)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("inbox_retention_setting")
}

model InboxCleanupLog {
  pkId                   BigInt   @id @default(autoincrement()) @map("pk_id")
  triggerType            String   @map("trigger_type") @db.VarChar(20)
  triggeredBy            String?  @map("triggered_by") @db.VarChar(255)
  cutoffAt               DateTime @map("cutoff_at")
  incomingHiddenCount    Int      @default(0) @map("incoming_hidden_count")
  outgoingHiddenCount    Int      @default(0) @map("outgoing_hidden_count")
  incomingDeletedCount   Int      @default(0) @map("incoming_deleted_count")
  outgoingDeletedCount   Int      @default(0) @map("outgoing_deleted_count")
  reactionDeletedCount   Int      @default(0) @map("reaction_deleted_count")
  mediaDeletedCount      Int      @default(0) @map("media_deleted_count")
  mediaDeleteFailedCount Int      @default(0) @map("media_delete_failed_count")
  createdAt              DateTime @default(now()) @map("created_at")

  @@index([createdAt], map: "idx_inbox_cleanup_log_created_at")
  @@map("inbox_cleanup_log")
}

/// Persistent WhatsApp profile-picture cache. Keeping the binary outside
/// IncomingMessage prevents temporary CDN URLs from being copied to every
/// message and makes the Inbox independent from a particular Node process.
model InboxProfileCache {
  pkId          Int       @id @default(autoincrement()) @map("pk_id")
  deviceId      Int       @map("device_id")
  jid           String    @db.VarChar(128)
  imageData     Bytes?    @map("image_data")
  mimeType      String?   @map("mime_type") @db.VarChar(100)
  status        String    @default("pending") @db.VarChar(20)
  fetchedAt     DateTime? @map("fetched_at")
  expiresAt     DateTime? @map("expires_at")
  nextRetryAt   DateTime? @map("next_retry_at")
  failureCount  Int       @default(0) @map("failure_count")
  lastErrorCode String?   @map("last_error_code") @db.VarChar(64)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  device        Device    @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)

  @@unique([deviceId, jid], map: "inbox_profile_cache_device_jid_key")
  @@index([deviceId, status], map: "idx_inbox_profile_cache_device_status")
  @@index([status, nextRetryAt], map: "idx_inbox_profile_cache_retry")
  @@map("inbox_profile_cache")
}

/// Current reaction state for an Inbox message. Reactions live separately
/// from incoming/outgoing messages so they cannot affect message delivery.
model MessageReaction {
  pkId              Int      @id @default(autoincrement()) @map("pk_id")
  deviceId          Int      @map("device_id")
  sessionId         String   @map("session_id") @db.VarChar(128)
  conversationJid   String   @map("conversation_jid") @db.VarChar(128)
  targetMessageId   String   @map("target_message_id") @db.VarChar(255)
  targetFromMe      Boolean  @map("target_from_me")
  reactorJid        String   @map("reactor_jid") @db.VarChar(128)
  emoji             String   @db.VarChar(64)
  reactionMessageId String?  @map("reaction_message_id") @db.VarChar(255)
  reactedAt         DateTime @map("reacted_at")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at")
  device            Device   @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)

  @@unique([deviceId, sessionId, targetMessageId, reactorJid], map: "message_reaction_state_key")
  @@index([deviceId, conversationJid], map: "idx_message_reaction_conversation")
  @@index([deviceId, targetMessageId, targetFromMe], map: "idx_message_reaction_target")
  @@map("message_reaction")
}

model Broadcast {
  pkId          Int      @id @default(autoincrement())
  id            String   @unique @default(uuid()) @db.Uuid
  name          String   @db.VarChar(128)
  status        Boolean  @default(true)
  recipients    String[]
  message       String   @db.Text
  schedule      DateTime
  delay         Int
  isSent        Boolean  @default(false)
  mediaPath     String?
  mediaFileName String?  @map("media_file_name") @db.VarChar(255)
  broadcastType String?  @map("broadcast_type") @db.VarChar(20) // 'broadcast' | 'reminder' | 'feedback' | 'recurrence'
  deviceId      Int
  device        Device   @relation(fields: [deviceId], references: [pkId], onDelete: Cascade)

  // Retry tracking fields
  lastAttemptAt DateTime? @map("last_attempt_at")
  attemptCount  Int       @default(0) @map("attempt_count")
  sentCount     Int?      @default(0) @map("sent_count")
  failedCount   Int?      @default(0) @map("failed_count")
  lastError     String?   @map("last_error") @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @default(now()) @map("updated_at")

  // Relation to per-recipient tracking
  broadcastRecipients BroadcastRecipient[]

  /// NOTE: Search optimization (ILIKE/contains) uses pg_trgm + GIN index created via SQL migration.
  /// Prisma doesn't support gin_trgm_ops in schema; do NOT add @@index(type: Gin) here.

  @@index([deviceId, schedule], map: "idx_broadcast_device_schedule")
  @@index([deviceId, name], map: "idx_broadcast_device_name")
  @@index([deviceId, status, isSent, schedule], map: "idx_broadcast_device_status_sent_schedule")
}

/// Per-recipient tracking for atomic broadcast processing
/// Enables crash recovery without re-sending to already-sent recipients
model BroadcastRecipient {
  pkId        Int       @id @default(autoincrement())
  broadcastId Int       @map("broadcast_id")
  broadcast   Broadcast @relation(fields: [broadcastId], references: [pkId], onDelete: Cascade)
  phone       String    @db.VarChar(30)
  jid         String?   @db.VarChar(50) // Resolved JID (e.g., 628xxx@s.whatsapp.net)
  status      String    @default("pending") @db.VarChar(20) // pending, sending, sent, failed, invalid, uncertain, terminal_failed
  sentAt      DateTime? @map("sent_at")
  errorMsg    String?   @map("error_msg") @db.Text
  messageId   String?   @map("message_id") @db.VarChar(128)
  retryCount  Int       @default(0) @map("retry_count")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at")

  @@unique([broadcastId, phone], map: "idx_broadcast_recipient_unique")
  @@index([broadcastId, status], map: "idx_broadcast_recipient_status")
  @@index([status, updatedAt], map: "idx_broadcast_recipient_batch")
  @@map("broadcast_recipients")
}

model AutoReply {
  pkId       Int      @id @default(autoincrement())
